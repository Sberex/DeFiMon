{
  "name": "defimon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "check:fluid": "tsx scripts/check-fluid.ts",
    "check:aave-v4": "tsx scripts/check-aave-v4.ts",
    "check:morpho": "tsx scripts/check-morpho.ts",
    "diagnose:morpho": "tsx scripts/diagnose-morpho.ts",
    "check:plasma": "tsx scripts/check-plasma.ts",
    "check:wallet": "tsx scripts/check-wallet.ts",
    "check:arbitrum": "tsx scripts/check-network.ts arbitrum",
    "check:susdai-apr": "tsx scripts/check-susdai-apr.ts",
    "check:merkl": "tsx scripts/check-merkl.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^7.16.0",
    "viem": "^2.38.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
