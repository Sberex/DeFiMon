# Server-side only. An Ethereum mainnet HTTPS RPC endpoint.
# No wallet, seed phrase, or signing key is needed.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional: a Plasma mainnet HTTPS provider (chain ID 9745).
# The public endpoint below is also the default when this variable is absent.
PLASMA_RPC_URL=https://rpc.plasma.to
PORT=3001
