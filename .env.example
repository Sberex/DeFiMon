# Server-side only. An Ethereum mainnet HTTPS RPC endpoint.
# No wallet, seed phrase, or signing key is needed.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional: a Plasma mainnet HTTPS provider (chain ID 9745).
# The public endpoint below is also the default when this variable is absent.
PLASMA_RPC_URL=https://rpc.plasma.to
# Optional: Arbitrum One mainnet HTTPS provider (chain ID 42161).
# Defaults to the public endpoint below if this variable is absent.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
PORT=3001

# Optional: enables CoinMarketCap contract-address matching for tokens missing from config/token-matches.json.
# Keep API keys on the server; never enter wallet private keys.
COINMARKETCAP_API_KEY=
# Optional CoinGecko Demo key (public CoinGecko lookup also works without a key, within its limits).
COINGECKO_API_KEY=
# Optional CoinGecko Pro key; when set, uses pro-api.coingecko.com instead of the public endpoint.
COINGECKO_PRO_API_KEY=
